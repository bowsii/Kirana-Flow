# EditorConfig — KiranaFlow
# https://editorconfig.org
# Aligned with ktlint 1.x defaults

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
# ktlint uses ij_kotlin_ namespace for its specific rules
ij_kotlin_imports_layout = *,java.**,javax.**,kotlin.**,^
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{json,yml,yaml}]
indent_size = 2

[*.xml]
indent_size = 4

[*.gradle]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
